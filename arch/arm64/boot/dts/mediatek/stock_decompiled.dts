/dts-v1/;

/ {
	model = "MT6781";
	compatible = "mediatek,MT6781";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	chosen {
		bootargs = "console=tty0 console=ttyS0,921600n1 root=/dev/ram \t\t\tvmalloc=400M slub_debug=OFZPU swiotlb=noforce \t\t\tinitcall_debug=1 \t\t\tfirmware_class.path=/vendor/firmware \t\t\tpage_owner=on loop.max_part=7";
		kaslr-seed = <0x00 0x00>;
		phandle = <0x91>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x02 0x03 0x04 0x05>;
			phandle = <0x08>;
		};

		cpu@001 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x02 0x03 0x04 0x05>;
			phandle = <0x09>;
		};

		cpu@002 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x02 0x03 0x04 0x05>;
			phandle = <0x0a>;
		};

		cpu@003 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x02 0x03 0x04 0x05>;
			phandle = <0x0b>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x02 0x03 0x04 0x05>;
			phandle = <0x0c>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x02 0x03 0x04 0x05>;
			phandle = <0x0d>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x600>;
			enable-method = "psci";
			clock-frequency = <0x7a308480>;
			cpu-idle-states = <0x06 0x07 0x04 0x05>;
			phandle = <0x0e>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x700>;
			enable-method = "psci";
			clock-frequency = <0x7a308480>;
			cpu-idle-states = <0x06 0x07 0x04 0x05>;
			phandle = <0x0f>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core3 {
					cpu = <0x0b>;
				};

				core4 {
					cpu = <0x0c>;
				};

				core5 {
					cpu = <0x0d>;
				};

				doe {
					phandle = <0x92>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				doe {
					phandle = <0x93>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff_l {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x640>;
				phandle = <0x02>;
			};

			cpuoff_b {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x578>;
				phandle = <0x06>;
			};

			clusteroff_l {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x834>;
				phandle = <0x03>;
			};

			clusteroff_b {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x76c>;
				phandle = <0x07>;
			};

			mcusysoff {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010002>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x4b0>;
				min-residency-us = <0xa28>;
				phandle = <0x04>;
			};

			s2idle {
				compatible = "mediatek,idle-state";
				arm,psci-suspend-param = <0x1010100>;
				local-timer-stop;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x578>;
				min-residency-us = <0xffffffff>;
				phandle = <0x05>;
			};
		};
	};

	mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		suspend-method = "s2idle";
		cpupm-method = "mcu";
		irq-remain = <0x10 0x11 0x12 0x13>;
		resource-ctrl = <0x14 0x15 0x16 0x17 0x18>;
		constraints = <0x19 0x1a 0x1b>;
		phandle = <0x94>;

		cpupm-sysram@0011b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0x95>;
		};

		mcusys-ctrl@0c53a000 {
			compatible = "mediatek,mcusys-ctrl";
			reg = <0x00 0xc53a000 0x00 0x1000>;
			phandle = <0x96>;
		};

		lpm_sysram@0011b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0x97>;
		};

		irq-remain-list {

			edge_keypad {
				target = <0x1c>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0x10>;
			};

			edge_mdwdt {
				target = <0x1d>;
				value = <0x01 0x00 0x00 0x2000000>;
				phandle = <0x11>;
			};

			level_btif_tx {
				target = <0x1e>;
				value = <0x00 0x01 0x00 0x00>;
				phandle = <0x12>;
			};

			level_btif_rx {
				target = <0x1e>;
				value = <0x00 0x02 0x00 0x00>;
				phandle = <0x13>;
			};
		};

		resource-ctrl-list {

			bus26m {
				id = <0x00>;
				value = <0x00>;
				phandle = <0x14>;
			};

			infra {
				id = <0x01>;
				value = <0x00>;
				phandle = <0x15>;
			};

			syspll {
				id = <0x02>;
				value = <0x00>;
				phandle = <0x16>;
			};

			dram_s0 {
				id = <0x03>;
				value = <0x00>;
				phandle = <0x17>;
			};

			dram_s1 {
				id = <0x04>;
				value = <0x00>;
				phandle = <0x18>;
			};
		};

		constraint-list {

			rc_bus26m {
				id = <0x00>;
				value = <0x01>;
				phandle = <0x19>;
			};

			rc_syspll {
				id = <0x01>;
				value = <0x01>;
				phandle = <0x1a>;
			};

			rc_dram {
				id = <0x02>;
				value = <0x01>;
				phandle = <0x1b>;
			};
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04>;
		cpus = <0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f>;
	};

	mcucfg_mp0_counter {
		compatible = "mediatek,mcucfg_mp0_counter";
		reg_mp0_counter_base = <0x1f>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x3e605000>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	aliases {
		ovl0 = "/disp_ovl0@14005000";
		ovl3 = "/disp_ovl0_2l@14006000";
		rdma0 = "/disp_rdma0@14007000";
		dsi0 = "/dsi@14013000";
		ccorr0 = "/disp_ccorr0@1400b000";
	};

	mobicore {
		compatible = "trustonic,mobicore";
		interrupts = <0x00 0x40 0x01>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x98>;

		zmc-default {
			compatible = "mediatek,zone_movable_cma";
			size = <0x00 0x2d000000>;
			alignment = <0x00 0x1000000>;
			alloc-ranges = <0x00 0xc0000000 0x04 0x00>;
		};

		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			no-map;
			status = "okay";
			size = <0x00 0x510000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x60000000>;
		};

		ion-carveout-heap {
			compatible = "mediatek,ion-carveout-heap";
			no-map;
			size = <0x00 0xc000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
		};

		reserve-memory-adsp_share {
			compatible = "mediatek,reserve-memory-adsp_share";
			no-map;
			size = <0x00 0x1000000>;
			alignment = <0x00 0x1000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x40000000>;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x00 0x500000>;
			alignment = <0x00 0x1000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
		};

		wifi-reserve-memory {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x00 0x600000>;
			alignment = <0x00 0x1000000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
			phandle = <0x3f>;
		};

		reserve-memory-scp_share {
			compatible = "mediatek,reserve-memory-scp_share";
			no-map;
			size = <0x00 0x300000>;
			alignment = <0x00 0x1000000>;
			alloc-ranges = <0x00 0x50000000 0x00 0x40000000>;
		};
	};

	interrupt-controller {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04>;
		phandle = <0x01>;
	};

	clkitg {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0x99>;

		bring-up {
			compatible = "mediatek,clk-bring-up";
			clocks = <0x20>;
		};
	};

	clocks {

		clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x00>;
			phandle = <0x9a>;
		};

		clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
			phandle = <0x20>;
		};

		clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xc65d40>;
			phandle = <0x31>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0x9b>;
		};
	};

	qos@0011bb80 {
		compatible = "mediatek,qos-2.0";
		reg = <0x00 0x11bb80 0x00 0x80>;
	};

	chipid@08000000 {
		compatible = "mediatek,chipid";
		reg = <0x00 0x8000000 0x00 0x04 0x00 0x8000004 0x00 0x04 0x00 0x8000008 0x00 0x04 0x00 0x800000c 0x00 0x04>;
	};

	topckgen@10000000 {
		compatible = "mediatek,topckgen\0syscon";
		reg = <0x00 0x10000000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x21>;
	};

	infracfg_ao@10001000 {
		compatible = "mediatek,infracfg_ao\0syscon";
		reg = <0x00 0x10001000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x30>;
	};

	dcm@10001000 {
		compatible = "mediatek,mt6781-dcm";
		reg = <0x00 0x10001000 0x00 0x1000 0x00 0xc538000 0x00 0x5000 0x00 0xc53a800 0x00 0x1000>;
		reg-names = "infracfg_ao\0mp_cpusys_top\0cpccfg_reg";
		phandle = <0x9c>;
	};

	scpsys@10001000 {
		compatible = "mediatek,scpsys";
		reg = <0x00 0x10001000 0x00 0x1000 0x00 0x10006000 0x00 0x1000 0x00 0x1020e000 0x00 0x1000 0x00 0x10000000 0x00 0x1000 0x00 0x14002000 0x00 0x1000>;
		#clock-cells = <0x01>;
		phandle = <0x2d>;
	};

	cache_parity {
		compatible = "mediatek,cache_parity";
		version = <0x01>;
		reg = <0x00 0xc530000 0x00 0x10000>;
		err_level = <0x01>;
		irq_config = <0x00 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x01 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x02 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x03 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x04 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x05 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x06 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x07 0x8090 0xff00 0x8090 0x44 0x8090 0xff 0x400 0xc8c0 0x1000000 0xc8c0 0x0c 0xc8c8 0x01>;
		interrupts = <0x00 0x16 0x04 0x00 0x17 0x04 0x00 0x18 0x04 0x00 0x19 0x04 0x00 0x1a 0x04 0x00 0x1b 0x04 0x00 0x1c 0x04 0x00 0x1d 0x04 0x00 0x13 0x04>;
	};

	lastbus@10001000 {
		compatible = "mediatek,lastbus-v1";
		reg = <0x00 0x10001000 0x00 0x1000 0x00 0x10003000 0x00 0x1000>;
	};

	scp_dvfs {
		compatible = "mediatek,scp_dvfs";
		clocks = <0x21 0x02 0x20 0x21 0x3a 0x21 0x37 0x21 0x39 0x21 0x36 0x21 0x46>;
		clock-names = "clk_mux\0clk_pll_0\0clk_pll_1\0clk_pll_2\0clk_pll_3\0clk_pll_4\0clk_pll_5";
		vsram_chk_gpio = <0x22 0xc8 0x00>;
	};

	iocfg_lt@10002000 {
		compatible = "mediatek,iocfg_lt";
		reg = <0x00 0x10002000 0x00 0x200>;
		phandle = <0x24>;
	};

	iocfg_lm@10002200 {
		compatible = "mediatek,iocfg_lm";
		reg = <0x00 0x10002200 0x00 0x200>;
		phandle = <0x25>;
	};

	iocfg_lb@10002400 {
		compatible = "mediatek,iocfg_lb";
		reg = <0x00 0x10002400 0x00 0x200>;
		phandle = <0x26>;
	};

	iocfg_bl@10002600 {
		compatible = "mediatek,iocfg_bl";
		reg = <0x00 0x10002600 0x00 0x200>;
		phandle = <0x27>;
	};

	iocfg_bm@10002800 {
		compatible = "mediatek,iocfg_bm";
		reg = <0x00 0x10002800 0x00 0x200>;
		phandle = <0x28>;
	};

	iocfg_rm@10002A00 {
		compatible = "mediatek,iocfg_rm";
		reg = <0x00 0x10002a00 0x00 0x200>;
		phandle = <0x29>;
	};

	iocfg_rt@10002C00 {
		compatible = "mediatek,iocfg_rt";
		reg = <0x00 0x10002c00 0x00 0x200>;
		phandle = <0x2a>;
	};

	iocfg_tl@10002E00 {
		compatible = "mediatek,iocfg_tl";
		reg = <0x00 0x10002e00 0x00 0x200>;
		phandle = <0x2b>;
	};

	pericfg@10003000 {
		compatible = "mediatek,pericfg\0syscon";
		reg = <0x00 0x10003000 0x00 0x1000>;
		phandle = <0x67>;
	};

	efuse_dbg@10004000 {
		compatible = "mediatek,efuse_dbg";
		reg = <0x00 0x10004000 0x00 0x1000>;
	};

	gpio@10005000 {
		compatible = "mediatek,gpio";
		reg = <0x00 0x10005000 0x00 0x1000>;
		phandle = <0x23>;
	};

	udi@10005000 {
		compatible = "mediatek,udi";
		reg = <0x00 0x10005000 0x00 0x1000>;
		udi_offset1 = <0x3a0>;
		udi_value1 = "D@\0";
		udi_offset2 = <0x3b0>;
		udi_value2 = <0x44>;
		ecc_debug = <0x01>;
		phandle = <0x9d>;
	};

	pinctrl {
		compatible = "mediatek,mt6781-pinctrl";
		reg_bases = <0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b>;
		reg_base_eint = <0x2c>;
		pins-are-numbered;
		gpio-controller;
		gpio-ranges = <0x22 0x00 0x00 0xca>;
		#gpio-cells = <0x02>;
		interrupt-controller;
		#interrupt-cells = <0x02>;
		interrupts = <0x00 0xba 0x04>;
		interrupt-parent = <0x01>;
		phandle = <0x22>;

		aud_clk_mosi_off {
			phandle = <0x42>;

			pins_cmd0_dat {
				pinmux = <0xb700>;
				input-enable;
				bias-pull-down;
			};

			pins_cmd1_dat {
				pinmux = <0xb800>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_clk_mosi_on {
			phandle = <0x43>;

			pins_cmd0_dat {
				pinmux = <0xb701>;
				input-schmitt-enable;
				bias-disable;
			};

			pins_cmd1_dat {
				pinmux = <0xb801>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_dat_mosi_off {
			phandle = <0x44>;

			pins_cmd1_dat {
				pinmux = <0xb900>;
				input-enable;
				bias-pull-down;
			};

			pins_cmd2_dat {
				pinmux = <0xba00>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_dat_mosi_on {
			phandle = <0x45>;

			pins_cmd1_dat {
				pinmux = <0xb901>;
				input-schmitt-enable;
				bias-disable;
			};

			pins_cmd2_dat {
				pinmux = <0xba01>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_dat_miso0_off {
			phandle = <0x46>;

			pins_cmd1_dat {
				pinmux = <0xbd00>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_dat_miso0_on {
			phandle = <0x47>;

			pins_cmd1_dat {
				pinmux = <0xbd01>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		aud_dat_miso1_off {
			phandle = <0x48>;

			pins_cmd2_dat {
				pinmux = <0xbe00>;
				input-enable;
				bias-pull-down;
			};
		};

		aud_dat_miso1_on {
			phandle = <0x49>;

			pins_cmd2_dat {
				pinmux = <0xbe01>;
				input-schmitt-enable;
				bias-disable;
			};
		};

		vow_dat_miso_off {
			phandle = <0x4a>;

			pins_cmd1_dat {
				pinmux = <0xbd00>;
				input-enable;
				bias-pull-down;
			};
		};

		vow_dat_miso_on {
			phandle = <0x4b>;

			pins_cmd1_dat {
